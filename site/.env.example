# NÃO ENVIE CREDENCIAIS REAIS POR CHAT OU GITHUB.
PORT=3000
DB_PATH=./data/maelink.sqlite
ADMIN_EMAIL=administrador@SEU-DOMINIO-INSTITUCIONAL
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_UNICA_COM_12_OU_MAIS_CARACTERES
# Habilitar SOMENTE atrás de HTTPS em produção
COOKIE_SECURE=true
# OPCIONAL: somente no SERVIDOR. Chat IA fica indisponível sem chave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHAT_SALT=DEFINA_UM_SEGREDO_RANDOMICO_PARA_HASH_DE_LIMITES

# Fusos por implantação: por padrão América/São_Paulo; outras regiões exigem alinhamento com a unidade.
HOSPITAL_TIME_ZONE=America/Sao_Paulo
